# Copy this file to server/.env and fill in your key.
# server/.env is gitignored — never commit real API keys.

# OpenAI API key — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Shared secret the mobile app must send in the `x-app-key` header.
# Must match EXPO_PUBLIC_APP_PROXY_KEY in the app's build env (eas.json / .env).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave unset to disable the check (e.g. for quick local testing).
APP_PROXY_KEY=

# Optional: change the port the proxy listens on (default 3000)
# PORT=3000

# Require a valid Firebase ID token (Authorization: Bearer <token>) on AI calls.
# Turn on only once most users run an app version that sends it (1.2.4+);
# older versions don't, and would get "Please sign in" errors.
# REQUIRE_FIREBASE_AUTH=true

# Service-account JSON used to verify those tokens (paste the whole JSON on one
# line). Firebase console → Project settings → Service accounts → Generate key.
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to the key file's path.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Require a valid Firebase App Check token (only the genuine Play-installed app
# can get one). Turn on once most users run a build that sends it, i.e. 1.2.9
# build 51 or later.
# REQUIRE_APP_CHECK=true

# Slack/Discord webhook for alerts: global cap at 80% and 100%, or usage counters
# failing. Without it, alerts only go to the server logs.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Number of proxies in front of this server, used to find the real client IP.
# To check it: set DEBUG_CLIENT_IP=true, compare `ip` at GET /api/debug/client-ip
# with your real public IP, adjust the hop count if needed, then remove the flag.
# TRUST_PROXY_HOPS=1
# DEBUG_CLIENT_IP=true

# Requests per 10 minutes from one IP, across all accounts (default 120).
# AI_IP_RATE_LIMIT=120

# Daily limits (defaults shown). See usageGuard.ts for what each one means.
# AI_DAILY_LIMIT_NEW=5
# AI_DAILY_LIMIT_FREE=40
# AI_DAILY_LIMIT_PREMIUM=200
# AI_DAILY_LIMIT_PER_IP=300
# AI_GLOBAL_DAILY_LIMIT=3000
# NEW_ACCOUNT_HOURS=24

# RevenueCat secret key (not the app's public key). Needed for premium users to
# get the premium AI allowance and to go past the free lesson limit. Without it,
# the server can't tell who's premium, so the free lesson limit isn't enforced.
# REVENUECAT_SECRET_KEY=sk_...

# Most XP an account can gain on the leaderboard per day of its age (default 1000).
# LEADERBOARD_MAX_XP_PER_DAY=1000

# Strict limits used while Firestore is unavailable (defaults shown).
# AI_FALLBACK_DAILY_LIMIT=300
# AI_FALLBACK_LIMIT_PER_USER=5
# AI_FALLBACK_LIMIT_PER_IP=20
